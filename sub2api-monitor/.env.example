MONITOR_IMAGE_TAG=dev
MONITOR_PORT=8080
MONITOR_ENVIRONMENT=production
MONITOR_DB_PASSWORD=replace-with-a-long-random-database-password
MONITOR_DB_PASSWORD_FILE=
MONITOR_DATABASE_URL=
MONITOR_DATABASE_URL_FILE=
MONITOR_MASTER_KEY=replace-with-at-least-32-random-bytes
MONITOR_MASTER_KEY_FILE=
MONITOR_ADMIN_USERNAME=admin
MONITOR_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
MONITOR_ADMIN_PASSWORD_FILE=
MONITOR_ALLOW_PRIVATE_TARGETS=false
MONITOR_ALLOW_PRIVATE_NOTIFICATION_TARGETS=false
MONITOR_TELEGRAM_API_ALLOWED_HOSTS=["api.telegram.org"]
MONITOR_NOTIFICATION_DISPATCH_CONCURRENCY=8
MONITOR_NOTIFICATION_CLAIM_SECONDS=120
MONITOR_ACTIVE_QUOTA_REFRESH_ENABLED=false
MONITOR_ACTIVE_QUOTA_TARGET_INTERVAL_SECONDS=300
MONITOR_ACTIVE_QUOTA_ACCOUNT_INTERVAL_SECONDS=900
MONITOR_ACTIVE_QUOTA_MAX_ACCOUNTS_PER_RUN=20
MONITOR_AUTOMATION_VERIFICATION_TIMEOUT_SECONDS=300
MONITOR_COST_ROUTING_DECISION_RETENTION_DAYS=30
MONITOR_HISTORY_RETENTION_DAYS=30
MONITOR_MAINTENANCE_INTERVAL_SECONDS=3600
MONITOR_LOG_LEVEL=INFO
