# Sub2API connection. Prefer an Admin API Key and restrict upstream routes at the proxy.
SUB2API_BASE_URL=https://sub2api.example.com
SUB2API_ADMIN_API_KEY=
# SUB2API_ADMIN_JWT=

# Generate independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REDEEM_CODE_PEPPER=replace-with-at-least-32-random-characters
REDEEM_SESSION_SECRET=replace-with-another-32-character-random-secret

# Login for https://redeem.example.com/admin (HTTP Basic).
REDEEM_MANAGER_USERNAME=redeem-admin
REDEEM_MANAGER_PASSWORD=replace-with-a-long-unique-password

# Comma-separated origins allowed to embed the user page.
# Use the public Sub2API origin, without a path.
REDEEM_FRAME_ANCESTORS='self',https://sub2api.example.com

REDEEM_HOST=0.0.0.0
REDEEM_PORT=8090
REDEEM_DATABASE_PATH=/app/data/redeem-platform.db
REDEEM_SESSION_TTL_SECONDS=900
REDEEM_UPSTREAM_TIMEOUT_MS=15000
REDEEM_RETRY_INTERVAL_MS=30000
REDEEM_MAX_ATTEMPTS=8
REDEEM_TRUST_PROXY=true
