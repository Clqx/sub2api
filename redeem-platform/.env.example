# Sub2API connection. Prefer an Admin API Key and restrict upstream routes at the proxy.
SUB2API_BASE_URL=https://sub2api.example.com
SUB2API_ADMIN_API_KEY=
# Optional alternative used by the unified Compose bootstrap container.
# SUB2API_ADMIN_API_KEY_FILE=/run/redeem-secrets/admin-api-key
# SUB2API_ADMIN_JWT=

# Generate independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REDEEM_CODE_PEPPER=replace-with-at-least-32-random-characters
REDEEM_SESSION_SECRET=replace-with-another-32-character-random-secret

# Login for https://redeem.example.com/admin (HTTP Basic).
REDEEM_MANAGER_USERNAME=redeem-admin
REDEEM_MANAGER_PASSWORD=replace-with-a-long-unique-password

# Comma-separated origins allowed to embed the user page.
# Use the public Sub2API origin, without a path.
REDEEM_FRAME_ANCESTORS='self',https://sub2api.example.com
# Optional override for origins allowed to fetch the public product catalog.
# Defaults to the HTTP(S) origins in REDEEM_FRAME_ANCESTORS.
# REDEEM_CATALOG_ORIGINS=https://sub2api.example.com

REDEEM_HOST=0.0.0.0
REDEEM_PORT=8090
# PostgreSQL connection. REDEEM_DATABASE_URL can replace the individual fields.
# REDEEM_DATABASE_URL=postgresql://redeem_platform:password@postgres:5432/redeem_platform
REDEEM_DATABASE_HOST=postgres
REDEEM_DATABASE_PORT=5432
REDEEM_DATABASE_USER=redeem_platform
REDEEM_DATABASE_PASSWORD=replace-with-a-strong-database-password
REDEEM_DATABASE_NAME=redeem_platform
REDEEM_DATABASE_SSLMODE=disable
REDEEM_DATABASE_POOL_SIZE=10
REDEEM_DATABASE_CONNECTION_TIMEOUT_MS=5000
REDEEM_SESSION_TTL_SECONDS=900
REDEEM_UPSTREAM_TIMEOUT_MS=15000
REDEEM_RETRY_INTERVAL_MS=30000
REDEEM_MAX_ATTEMPTS=8
REDEEM_TRUST_PROXY=true
