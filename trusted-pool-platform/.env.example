# API
# Compose 内部固定监听 8092；只通过本变量调整宿主机暴露端口。
TRUSTED_POOL_API_PORT=8092
TRUSTED_POOL_API_KEY=replace-with-at-least-32-random-characters
# 人工解除 pending settlement 的独立高权限密钥，不得与普通平台 API Key 复用。
TRUSTED_POOL_SETTLEMENT_API_KEY=replace-with-a-different-32-character-secret
# 凭据批次 Seal/Activate/Retire 的独立高权限入口，不得与普通或 settlement 密钥复用。
TRUSTED_POOL_BATCH_API_KEY=replace-with-a-third-32-character-secret
TRUSTED_POOL_FINGERPRINT_HMAC_KEY=replace-with-at-least-32-random-characters
# Provision credential 一次性领取窗口；默认 10m，最长 24h。
TRUSTED_POOL_CLAIM_TTL=10m
# 每个运行实例必须唯一，用于数据库 lease owner 与 fencing 审计。
TRUSTED_POOL_WORKER_ID=trusted-pool-api-local-1
TRUSTED_POOL_WORKFLOW_LEASE_DURATION=30s
TRUSTED_POOL_RECOVERY_BACKOFF=1m
TRUSTED_POOL_RECOVERY_IDLE_BACKOFF=1s

# 本文件默认值只用于本地开发。生产必须改为 production+kms，并链接 KMS adapter。
TRUSTED_POOL_RUNTIME_MODE=development
TRUSTED_POOL_ENVELOPE_MODE=local
TRUSTED_POOL_ALLOW_INSECURE_LOCAL_KEK=true
TRUSTED_POOL_KMS_KEY_REF=development/local-kek
# 仅 development+local+显式 allow 时读取；生产配置存在该值会拒绝启动。
TRUSTED_POOL_KEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Phase2-E 分阶段凭据批次。生产必须由组合根注入两个原生 context-aware wrapper；以下 Recovery KEK 仅供开发。
TRUSTED_POOL_BATCH_CLIENT_ID=trusted-pool-batch-api
TRUSTED_POOL_BATCH_KMS_WRAP_ALGORITHM=LOCAL-AES-256-GCM-CONTEXT-V1
TRUSTED_POOL_BATCH_KMS_DOMAIN=development-online-kms
TRUSTED_POOL_BATCH_KMS_KEY_REF=development/batch-online-key
TRUSTED_POOL_BATCH_RECOVERY_WRAP_ALGORITHM=LOCAL-AES-256-GCM-RECOVERY-CONTEXT-V1
TRUSTED_POOL_BATCH_RECOVERY_DOMAIN=development-recovery-wrapper
TRUSTED_POOL_BATCH_RECOVERY_KEY_REF=development/batch-recovery-key
TRUSTED_POOL_BATCH_FINGERPRINT_KEY_REF=development/batch-fingerprint-v1
TRUSTED_POOL_BATCH_FINGERPRINT_HMAC_KEY_HEX=89abcdef0123456789abcdef0123456789abcdef0123456789abcdef01234567
# 必须与 TRUSTED_POOL_KEK_HEX 不同；生产配置存在该值会拒绝启动。
TRUSTED_POOL_RECOVERY_KEK_HEX=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# 独立数据库；不得指向 Sub2API 数据库
TRUSTED_POOL_DB_PORT=55432
TRUSTED_POOL_DB_NAME=trusted_pool
TRUSTED_POOL_DB_USER=trusted_pool
TRUSTED_POOL_DB_PASSWORD=replace-with-a-long-random-password
# Compose 示例；密码含 URL 特殊字符时必须进行百分号编码。
TRUSTED_POOL_DATABASE_URL=postgres://trusted_pool:replace-with-a-long-random-password@postgres:5432/trusted_pool?sslmode=disable
TRUSTED_POOL_MIGRATION_TIMEOUT=2m
TRUSTED_POOL_DB_MAX_OPEN=20
TRUSTED_POOL_DB_MAX_IDLE=5

# 生产模式必填实际 provider 名称并由组合根注入实现；当前仓库不会回退到环境 KEK。
TRUSTED_POOL_KMS_PROVIDER=

# Sub2API 服务间集成。必须使用窄权限集成凭据，禁止使用浏览器令牌或全权限 Admin API Key。
SUB2API_BASE_URL=http://host.docker.internal:8080
SUB2API_INTEGRATION_CLIENT_ID=trusted-pool-platform
SUB2API_INTEGRATION_SECRET=replace-with-at-least-16-random-characters
# Pending settlement 只读与 resolve 各用独立、窄权限服务凭据；三组 ID 和 secret 均不得复用。
SUB2API_SETTLEMENT_READ_CLIENT_ID=trusted-pool-settlement-read
SUB2API_SETTLEMENT_READ_SECRET=replace-with-a-distinct-read-secret
SUB2API_SETTLEMENT_RESOLVE_CLIENT_ID=trusted-pool-settlement-resolve
SUB2API_SETTLEMENT_RESOLVE_SECRET=replace-with-a-distinct-resolve-secret
